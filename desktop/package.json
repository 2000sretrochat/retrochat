{
  "name": "yappchat-desktop",
  "productName": "YappChat",
  "version": "1.2.0",
  "description": "YappChat desktop app",
  "author": "YappChat",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": { "dist": "electron-builder --win nsis --x64" },
  "devDependencies": { "electron": "^33.0.0", "electron-builder": "^25.1.8" },
  "build": {
    "appId": "app.yappchat.desktop",
    "productName": "YappChat",
    "copyright": "YappChat",
    "files": ["main.js", "preload.js", "build/icon.png"],
    "directories": { "output": "dist", "buildResources": "build" },
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "build/icon.png", "artifactName": "YappChat-Setup.${ext}" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "shortcutName": "YappChat" }
  }
}
