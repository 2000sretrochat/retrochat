{
  "name": "razzle-messenger-desktop",
  "productName": "Razzle Messenger",
  "version": "13.10.2",
  "description": "Razzle Messenger desktop app (Beta)",
  "author": "Razzle Social",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "dist": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.razzlesocial.messenger",
    "productName": "Razzle Messenger",
    "copyright": "Razzle Social",
    "files": [
      "main.js",
      "preload.js",
      "micvol.js",
      "signin-store.js",
      "build/icon.png",
      "build/icon.ico"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "2000sretrochat",
        "repo": "retrochat",
        "releaseType": "draft"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "RazzleMessenger-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Razzle Messenger",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createStartMenuShortcut": true
    }
  }
}
